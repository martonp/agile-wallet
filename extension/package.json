{
  "name": "agile-wallet-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:sphincs": "cargo build --release --target wasm32-unknown-unknown --manifest-path sphincs-wasm/Cargo.toml && cp sphincs-wasm/target/wasm32-unknown-unknown/release/agile_sphincs_wasm.wasm src/wallet/sphincs.wasm"
  },
  "dependencies": {
    "@forshtat/hegota-support": "0.0.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tabler/icons-react": "^3.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "2.57.7",
    "zknox-falcon": "file:vendor/zknox-falcon"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
